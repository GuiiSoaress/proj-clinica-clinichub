{
  "expo": {
    "name": "app_clinica",
    "slug": "app_clinica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "react-native-ble-plx",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O ClinicHub usa a câmera para tirar a foto de perfil no cadastro.",
          "photosPermission": "O ClinicHub acessa a galeria para escolher uma foto de perfil."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O ClinicHub usa a biometria para destrancar sua sessão salva com rapidez."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ClinicHub usa sua localização apenas para calcular a distância até a clínica."
        }
      ],
      "expo-status-bar"
    ]
  }
}

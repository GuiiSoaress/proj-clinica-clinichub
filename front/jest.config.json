{
  "preset": "jest-expo",
  "setupFiles": ["./jest.setup.js"],
  "testPathIgnorePatterns": ["/node_modules/", "/servidor/"],
  "moduleNameMapper": {
    "^expo-modules-core$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core",
    "^expo-modules-core/(.*)$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core/$1"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-async-storage|@react-native-picker)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-ble-plx)"
  ]
}
